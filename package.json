{
  "name": "stack-base",
  "version": "0.7.9",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently --names \"next,worker\" --prefix-colors \"cyan,yellow\" \"npm run dev\" \"npm run worker:watch\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "dotenv -e .env -- npx tsx prisma/seed.ts",
    "worker": "dotenv -e .env -- npx tsx src/worker/index.ts",
    "worker:watch": "dotenv -e .env -- npx tsx --watch src/worker/index.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/marked": "^5.0.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.27.0",
    "marked": "^18.0.7",
    "minio": "^8.0.7",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "node-cron": "^4.6.0",
    "nodemailer": "^8.0.11",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
