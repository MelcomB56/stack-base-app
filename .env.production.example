# Datenbank (Hostname = Docker-Service-Name "postgres")
DATABASE_URL="postgresql://stackbase:POSTGRES_PASSWORD@postgres:5432/stackbase"
POSTGRES_USER="stackbase"
POSTGRES_PASSWORD="AENDERN_stark_generiert"
POSTGRES_DB="stackbase"

# Redis (Hostname = Docker-Service-Name "redis")
REDIS_URL="redis://redis:6379"

# Auth (next-auth v5)
# Generieren: openssl rand -base64 32
AUTH_SECRET="AENDERN_openssl_rand_base64_32"
AUTH_TRUST_HOST="true"

# Authentik OIDC (SSO)
# OAuth-App in Authentik für stack-base anlegen -> Client ID + Secret kopieren
AUTHENTIK_CLIENT_ID="AUTHENTIK_CLIENT_ID"
AUTHENTIK_CLIENT_SECRET="AUTHENTIK_CLIENT_SECRET"
AUTHENTIK_ISSUER="https://auth.DEINE_DOMAIN.de/application/o/stack-base/"

# MinIO (Hostname = Docker-Service-Name "minio")
# Root-User wird gleichzeitig als MINIO_ROOT_USER/PASSWORD verwendet
MINIO_ENDPOINT="http://minio:9000"
MINIO_ACCESS_KEY="AENDERN_minio_user"
MINIO_SECRET_KEY="AENDERN_minio_password_min_8_zeichen"
MINIO_BUCKET="stack-base"

# Verschlüsselung (AES-256)
# Generieren: openssl rand -hex 32
ENCRYPTION_KEY="AENDERN_openssl_rand_hex_32"

# App
NEXT_PUBLIC_APP_URL="https://stack-base.de"
